# MAFHUM local configuration template.
#
# Copy to `.env` and adjust. Never commit real secrets — `.env` is gitignored.
#
# Every variable below is a real field of `Settings` in
# `apps/api/src/mafhum_api/config.py`. Names are matched case-insensitively and
# there is **no prefix**. Values shown are the application defaults, so a
# variable can be deleted to fall back to its default.

# --- environment -----------------------------------------------------------
# development | test | production
# In production the app refuses to start unless SESSION_SECRET is set,
# COOKIE_SECURE is true, and DATABASE_URL does not point at localhost.
APP_ENV=development
APP_NAME=MAFHUM
API_PREFIX=/api/v1
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console

# --- database (PostgreSQL 14+) ---------------------------------------------
DATABASE_URL=postgresql+psycopg://mafhum:change_me@localhost:5432/mafhum
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- private blob storage ---------------------------------------------------
# Uploaded files live here, outside any static/public directory. They are never
# served directly: every read goes through an authorized API endpoint.
# Only "local" is implemented; the backend is behind an interface so an
# object-store can be added without changing callers.
STORAGE_BACKEND=local
STORAGE_ROOT=./data/mafhum-storage
# Decimal. 448 = 0o700 (directories), 384 = 0o600 (files).
STORAGE_DIR_MODE=448
STORAGE_FILE_MODE=384

# --- sessions and CSRF ------------------------------------------------------
# REQUIRED in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-insecure-change-me
SESSION_COOKIE_NAME=mafhum_session
CSRF_COOKIE_NAME=mafhum_csrf
CSRF_HEADER_NAME=X-CSRF-Token
SESSION_TTL_MINUTES=10080
# Must be true behind HTTPS in production.
COOKIE_SECURE=false
# JSON list. Cookie-authenticated mutations are rejected unless Origin/Referer
# matches one of these exactly (parsed, never substring-matched).
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- upload limits (server-authoritative; the UI only mirrors them) ---------
MAX_UPLOAD_MB=20
MAX_EXTRACTED_CHARS=5000000
MAX_PDF_PAGES=200
MAX_DOCX_ENTRIES=400
MAX_DOCX_UNCOMPRESSED_MB=60
MAX_ARCHIVE_COMPRESSION_RATIO=100.0
MAX_SEGMENT_CHARS=4000

# --- per-user quotas --------------------------------------------------------
MAX_DOCUMENTS_PER_USER=50
MAX_TOTAL_BYTES_PER_USER_MB=500
MAX_CONCURRENT_UPLOADS_PER_USER=3

# --- brute-force throttle (database-enforced, shared by all replicas) -------
LOGIN_THROTTLE_WINDOW_SECONDS=60
LOGIN_THROTTLE_MAX_ATTEMPTS=10

# --- processing worker ------------------------------------------------------
# In-process bounded pool using SELECT ... FOR UPDATE SKIP LOCKED. Quotas and
# the login throttle are database-enforced and safe across replicas; this pool
# is NOT shared. A PostgreSQL advisory lock allows exactly one worker per
# database, so disable it on every replica except the processing instance.
PROCESSING_WORKER_ENABLED=true
PROCESSING_WORKER_COUNT=2
PROCESSING_JOB_TIMEOUT_SECONDS=120
PROCESSING_STALE_AFTER_SECONDS=300
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_STARTUP_RECOVERY=true

# --- malware scanning (optional; no engine ships with MAFHUM) ---------------
# Point at a running clamd daemon to enable scanning. Leave both paths empty to
# keep the disclosed "not scanning" state. With MALWARE_SCAN_REQUIRED=true,
# uploads are REJECTED unless a real engine returns a CLEAN verdict.
CLAMD_UNIX_PATH=
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=10.0
MALWARE_SCAN_REQUIRED=false

# --- request handling -------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- editable presentations (Phase 6) ---------------------------------------
# One request is bounded by these caps: at most 20 decks per user, 6 citations
# per deck, and 8 MB of generated PPTX. Generation is synchronous and
# deterministic (no external model or service is called).
MAX_PRESENTATIONS_PER_USER=20
PRESENTATION_MAX_CITATIONS=6
PRESENTATION_MAX_OUTPUT_MB=8

# --- research / AI ----------------------------------------------------------
# Off by default. Nothing in MAFHUM requires a paid provider, and no document
# content is sent anywhere unless this is explicitly enabled and configured.
ENABLE_AI_GATEWAY=false
# External source retrieval (JORADP/ASJP/SNDL). Off by default: core MAFHUM
# needs no outbound network. URLs are SSRF-validated before any request.
RESEARCH_RETRIEVAL_ENABLED=false
