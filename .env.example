# Copy to .env for local development. Never put real secrets in this tracked file.
APP_ENV=development
APP_NAME=MAFHUM
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://mafhum:dev_only@db:5432/mafhum
AI_PROVIDER=mock
AI_MODEL=mock
MAX_UPLOAD_MB=20
MAX_DOCUMENT_PAGES=200
MAX_OUTPUT_TOKENS=2000
REQUEST_TIMEOUT_SECONDS=30
ALLOW_DEV_ORIGINS=http://localhost:3000
TRUSTED_PROXY_IPS=
SESSION_COOKIE_NAME=mafhum_session
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_MINUTES=10080
SESSION_MAX_PER_USER=10
AUTH_RATE_LIMIT=5
AUTH_IP_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
DEFAULT_PROJECT_QUOTA=5
