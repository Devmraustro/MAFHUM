# Template for the self-hosted production stack. Copy to a secrets manager or
# an untracked .env file on the host. NEVER commit real values.
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- operator-owned host ---------------------------------------------------
MAFHUM_DOMAIN=change-me.example.org
MAFHUM_ACME_EMAIL=operator@change-me.example.org

# --- database ---------------------------------------------------------------
POSTGRES_USER=mafhum
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=mafhum

# --- application ------------------------------------------------------------
SESSION_SECRET=REPLACE_WITH_A_48_BYTE_RANDOM_SECRET
ALLOWED_ORIGINS=["https://change-me.example.org"]

# Optional: only set true after a real clamd engine answered the EICAR probe.
MALWARE_SCAN_REQUIRED=false
CLAMD_UNIX_PATH=
