# Template for the self-hosted production stack. Copy to a secrets manager or
# an untracked .env file on the host. NEVER commit real values.
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Every value below is a placeholder. The Compose file and
# tools/acceptance/prod_compose_contract.py assert that none of these are
# shipped as defaults in an image or a tracked file.

# --- operator-owned host ---------------------------------------------------
MAFHUM_DOMAIN=change-me.example.org
MAFHUM_ACME_EMAIL=operator@change-me.example.org

# --- database ---------------------------------------------------------------
POSTGRES_USER=mafhum
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=mafhum

# --- application ------------------------------------------------------------
SESSION_SECRET=REPLACE_WITH_A_48_BYTE_RANDOM_SECRET
ALLOWED_ORIGINS=["https://change-me.example.org"]

# --- malware scanning (mandatory in production) ----------------------------
# docker-compose.prod.yml hard-codes MALWARE_SCAN_REQUIRED=true and points
# CLAMD_HOST at the clamd service. This variable is retained so an operator who
# temporarily relaxes the policy must do so *deliberately and in one place*, and
# so the deployment contract can assert the intended value.
MALWARE_SCAN_REQUIRED=true
CLAMD_HOST=clamd
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=10.0

# --- scoped monitoring ------------------------------------------------------
# High-entropy (>= 32 chars) bearer token granting access to
# /api/v1/admin/metrics ONLY. Store in a secrets manager or a Docker secret;
# never in the frontend, never in a URL, never in this repository.
METRICS_SCRAPE_TOKEN=REPLACE_WITH_A_SEPARATE_HIGH_ENTROPY_METRICS_TOKEN

# --- audit-log retention ----------------------------------------------------
# 0 keeps every audit event indefinitely. A positive value is a retention window
# in days for `python apps/api/tools/purge_audit.py`, which must be scheduled
# explicitly; nothing deletes audit rows automatically. Set this only after the
# owner has approved a retention policy and considered legal-hold obligations.
AUDIT_RETENTION_DAYS=0
