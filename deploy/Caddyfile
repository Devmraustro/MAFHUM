# Caddy terminates TLS and is the only public entry point for the self-hosted
# MAFHUM stack. The domain and ACME contact come from the environment; neither
# is hardcoded or invented in this repository.
#
#   MAFHUM_DOMAIN       e.g. mafhum.example.org (operator-owned)
#   MAFHUM_ACME_EMAIL   contact for certificate expiry notices
#
{
	email {$MAFHUM_ACME_EMAIL}
}

{$MAFHUM_DOMAIN} {
	encode zstd gzip

	# Security headers. The API also sets its own; Caddy adds them for the
	# static/Next responses the API never sees.
	#
	# The CSP is deliberately conservative: it locks every fetch directive to
	# 'self' plus only what Next.js needs for hydration (inline scripts/styles)
	# and blocks embedding, plugins and base-uri tampering. It is part of the
	# deployment rehearsal to open the site in a real browser under this header
	# before going live; tightening it further (nonces instead of 'unsafe-inline')
	# is an owner follow-up, not something this template can verify on its own.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# /api and /health are proxied by the Next server to the API service; a
	# direct route here avoids a double hop for API-only clients. The metrics
	# path is listed explicitly so Prometheus can scrape it without going
	# through the Next rewriter. It is NOT public data: the API requires a
	# scoped bearer token (see deploy/prometheus/prometheus.yml).
	@backend path /health/* /api/docs /api/openapi.json /api/v1/admin/metrics
	handle @backend {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
